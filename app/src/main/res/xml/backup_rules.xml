<?xml version="1.0" encoding="utf-8"?>
<!--
  API ≤ 30 (only cloud backup exists here). Same reasoning as the <cloud-backup> block in
  data_extraction_rules.xml: restoring the Room library without the audio files in Music/BestiaPop
  leaves unplayable rows, and the restored scan flag suppresses the rescan that rebuilds them.
-->
<full-backup-content>
    <exclude domain="database" path="bestiapop_music_db" />
    <exclude domain="database" path="bestiapop_music_db-shm" />
    <exclude domain="database" path="bestiapop_music_db-wal" />
    <exclude domain="file" path="datastore/library_settings.preferences_pb" />
    <exclude domain="file" path="datastore/playback_session.preferences_pb" />
    <exclude domain="file" path="datastore/active_downloads.preferences_pb" />
    <exclude domain="file" path="datastore/identify_review.preferences_pb" />
    <exclude domain="file" path="datastore/listenbrainz_settings.preferences_pb" />
</full-backup-content>
