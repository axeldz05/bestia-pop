# Copiá a keystore.properties (gitignored) y completá con el keystore de upload de Play.
# Generar: keytool -genkeypair -v -keystore bestiapop-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias bestiapop
storeFile=bestiapop-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=bestiapop
keyPassword=YOUR_KEY_PASSWORD
